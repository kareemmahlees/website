---
import BaseLayout from "@/layouts/BaseLayout.astro";
import "@/styles/globals.css";
import {Image} from "astro:assets"
import Download from "../assets/download.svg"
import ArrowUpRight from "../assets/arrow-up-right.svg"
import { getCollection } from "astro:content";

const experience = (await getCollection('experience')).sort((a, b) => a.data.order - b.data.order)
const projects = (await getCollection('projects')).sort((a, b) => b.data.year.localeCompare(a.data.year))

const connections = [
  {name:'Email',display:"kareemmahlees@gmail.com",link:"mailto:kareemmahlees@gmail.com"},
  {name:'LinkedIn',display:"linkedin.com/in/kareem-mahlees",link:"https://www.linkedin.com/in/kareem-mahlees"},
  {name:'GitHub',display:"github.com/kareemmahlees",link:"https://www.github.com/kareemmahlees"},
  {name:'Cal.com',display:"cal.com/kareem-ebrahim",link:'https://www.cal.com/kareem-ebrahim'}
]

---

<BaseLayout title="Kareem Ebrahim" description="something">
    <main class="mx-auto w-full max-w-[760px] px-5 sm:px-8">
         <header class="flex min-h-[76px] items-center justify-between gap-6 border-b border-border">
             <a href="#top" class="flex flex-col text-sm font-medium leading-[1.45]" aria-label="Kareem Ebrahim's home">
             <span>Kareem Ebrahim</span>
             <span class="text-[11px] font-normal text-muted-foreground">Software engineer</span>
             </a>
           <a class="inline-flex min-h-[38px] items-center justify-center gap-2 rounded-md bg-accent px-3.5 text-[11px] font-semibold text-accent-foreground transition hover:-translate-y-px hover:bg-[#b7c09e] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ring" href="https://docs.google.com/document/u/0/export?format=pdf&id=1js7jkFavUT6LgHqmUikKH0Fucz5Akjcbi0yNuR3XAno" download>
               Download CV <Image src={Download} width={14} aria-hidden="true" alt="Download CV"/>
           </a>
         </header>

         <section id="top" class="py-10 sm:py-[52px]">
           <p class="mb-[18px] text-xs text-muted-foreground">T-Shaped Software Engineer</p>
           <h1 class="mb-3.5 max-w-[640px] text-[clamp(26px,4vw,36px)] font-medium leading-[1.4] tracking-[-0.055em]">I make thoughtful things for the web.</h1>
           <p class="max-w-[640px] text-sm leading-[1.8] text-[#c1c0bb]">I’m Kareem. I build software across the stack, from the first shape of an idea to the details that make it reliable in production.</p>
         </section>

         <section id="experience" class="mb-[50px] rounded-lg bg-card px-4 pb-4 pt-5 sm:mb-16 sm:px-6 sm:pb-5 sm:pt-[22px]">
           <div class="mb-3 flex flex-col gap-[3px] sm:mb-4 sm:flex-row sm:items-baseline sm:justify-between sm:gap-[18px]">
             <h2 class="text-[15px] font-medium leading-[1.5]">Work experience</h2>
             <p class="text-[11px] text-muted-foreground">Teams, roles, and work over time.</p>
           </div>
           <div class="flex flex-col gap-[3px]">
             {experience.map((item) => (
               <a class="group -mx-2 grid grid-cols-[minmax(0,1fr)_18px] gap-x-2 gap-y-2 rounded-md px-2 py-3.5 transition-colors hover:bg-secondary sm:grid-cols-[130px_minmax(0,1fr)_18px] sm:items-start sm:gap-x-3.5 sm:py-[15px]" href={`/experience/${item.id}`} key={item.id}>
                 <span class="row-start-1 text-[11px] text-muted-foreground sm:col-start-1 sm:row-auto sm:pt-[3px]">{item.data.years}</span>
                 <div class="col-start-1 row-start-2 sm:col-start-2 sm:row-auto">
                   <h3 class="text-sm font-medium leading-[1.55]">{item.data.role}</h3>
                   <p class="mb-2 mt-0.5 flex flex-wrap gap-x-3 text-[11px] text-accent">{item.data.company}<span class="text-muted-foreground">{item.data.location}</span></p>
                   <p class="max-w-[470px] text-xs leading-[1.65] text-muted-foreground">{item.data.shortDescription}</p>
                 </div>
                 <Image src={ArrowUpRight} class="col-start-2 row-start-1 mt-[3px] transition group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-accent sm:col-start-3 sm:row-auto" width={15} aria-hidden="true" alt="See experience"/>
               </a>
             ))}
           </div>
         </section>

         <section id="projects" class="mb-[54px] sm:mb-[68px]">
           <div class="mb-3 flex flex-col gap-[3px] sm:mb-4 sm:flex-row sm:items-baseline sm:justify-between sm:gap-[18px]">
             <h2 class="text-[15px] font-medium leading-[1.5]">Selected projects</h2>
             <p class="text-[11px] text-muted-foreground">A few things I’ve worked on.</p>
           </div>
           <div class="flex flex-col">
             {projects.map((project) => (
               <a class="group -mx-2 grid grid-cols-[minmax(0,1fr)_18px] gap-x-3 gap-y-1 rounded-sm border-t border-border px-2 py-3 first:border-t-0 sm:grid-cols-[minmax(0,1fr)_48px_18px] sm:py-3.5" href={`/projects/${project.id}`} key={project.id}>
                 <div class="col-start-1 row-start-1">
                   <h3 class="text-[13px] font-medium">{project.data.title}</h3>
                   <p class="mt-1 text-[11px] leading-[1.6] text-muted-foreground">{project.data.summary}</p>
                 </div>
                 <span class="col-start-1 row-start-2 text-left text-[10px] leading-[1.6] text-muted-foreground sm:col-start-2 sm:row-start-1 sm:text-right">{project.year}</span>
                 <Image src={ArrowUpRight} class="col-start-2 row-start-1 mt-0.5 transition group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-accent sm:col-start-3" width={15} aria-hidden="true" alt="Open link"/>
               </a>
             ))}
           </div>
         </section>

         <section id="contact" class="mb-[42px] sm:mb-[52px]">
           <div class="mb-3 flex flex-col gap-[3px] sm:mb-4 sm:flex-row sm:items-baseline sm:justify-between sm:gap-[18px]">
             <h2 class="text-[15px] font-medium leading-[1.5]">Elsewhere</h2>
             <p class="text-[11px] text-muted-foreground">Get in touch or find me online.</p>
           </div>
           <div class="flex flex-col gap-1">
               {connections.map(conn=>(
               <a class="grid grid-cols-[70px_minmax(0,1fr)_18px] items-center gap-2 py-2 text-xs hover:text-foreground sm:grid-cols-[100px_minmax(0,1fr)_18px] sm:gap-3" href={conn.link} target="_blank" rel="noopener noreferrer" aria-label="Open link" aria-hidden="true" alt="Open link">
                       {conn.name}
                   <span class="text-[11px] text-muted-foreground">{conn.display}</span>
                   <Image src={ArrowUpRight} width={15} aria-hidden="true" alt="Open link"/>
               </a>
               ))}
           </div>
         </section>

         <footer class="flex justify-between gap-5 py-5 pb-[30px] text-[10px] text-muted-foreground"><span>© 2025 Alex Morgan</span><a class="hover:text-foreground" href="#top">Back to top ↑</a></footer>
       </main>
</BaseLayout>
